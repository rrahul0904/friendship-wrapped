# ThreadTales / Story Platform environment template
#
# The free local ThreadTales analyzer requires no secrets and no database.
# NEXT_PUBLIC_SITE_URL is optional; secure server routes fall back to the request origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 4 — optional Stripe one-time premium artifacts.
# Server-only. Leave unset to keep checkout disabled while the free product remains functional.
STRIPE_SECRET_KEY=
STRIPE_PRICE_THREADTALES_PREMIUM=
STRIPE_WEBHOOK_SECRET=
ENTITLEMENT_SIGNING_SECRET=

# Phase 5/8 — optional Supabase authentication, derived-story persistence, and PetLife households.
# Browser-safe publishable values use NEXT_PUBLIC_. SUPABASE_SECRET_KEY is server-only.
# Configure these only against a dedicated Story Platform project; do not point at an unrelated database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Phase 10 — optional OpenAI story enrichment.
# Server-only. The deterministic products work without these values.
# ThreadTales sends allowlisted derived metrics/share-safe chapters by default; selected snippets require consent.
OPENAI_API_KEY=
OPENAI_STORY_MODEL=gpt-5.6-luna

# Phase 11 — optional external product telemetry.
# Server-only. Without TELEMETRY_ENDPOINT, accepted allowlisted events are a local 202 no-op.
# The endpoint must use HTTPS. TELEMETRY_API_KEY is optional and never exposed to browser code.
TELEMETRY_ENDPOINT=
TELEMETRY_API_KEY=
