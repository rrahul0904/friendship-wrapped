# ThreadTales / Story Platform environment template
# The free local ThreadTales analyzer requires no secrets and no database.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional PulseAtlas portfolio observability. SERVER-SIDE only.
# Receives only sanitizeProductEvent() output: event, product, and allowlisted mode.
# Raw chat, participant names, top words, photos, captions and story content are never included.
PULSEATLAS_ENDPOINT=
PULSEATLAS_WRITE_KEY=
PULSEATLAS_ENVIRONMENT=production

# Phase 4 — optional Stripe one-time premium artifacts.
STRIPE_SECRET_KEY=
STRIPE_PRICE_THREADTALES_PREMIUM=
STRIPE_WEBHOOK_SECRET=
ENTITLEMENT_SIGNING_SECRET=

# Phase 5/8 — optional Supabase authentication, derived-story persistence, and PetLife households.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Phase 10 — optional OpenAI story enrichment.
OPENAI_API_KEY=
OPENAI_STORY_MODEL=gpt-5.6-luna

# Phase 11 — optional external product telemetry.
# Server-only. Without TELEMETRY_ENDPOINT, accepted allowlisted events are a local 202 no-op.
TELEMETRY_ENDPOINT=
TELEMETRY_API_KEY=
