# Core free ThreadTales flow needs only the public site URL.
# Raw chats are parsed locally in the browser and are never uploaded by the free analyzer.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 4 — optional Stripe one-time premium artifacts.
# Leave unset to keep checkout disabled while the free product remains fully functional.
STRIPE_SECRET_KEY=
STRIPE_PRICE_THREADTALES_PREMIUM=
STRIPE_WEBHOOK_SECRET=
ENTITLEMENT_SIGNING_SECRET=

# Phase 5 — optional Supabase persistence for derived stories / MyYear / PetLife.
# Never expose a Supabase secret/service key with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Phase 10 — optional OpenAI-compatible AI enrichment endpoint.
# Only derived metrics and explicit user-selected snippets may be sent.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
