# ThreadTales environment template
#
# The free analyzer still needs no secrets or database.
# Raw chats are parsed locally in the browser and are never uploaded merely to
# generate the free or deterministic premium story.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PREMIUM_PRICE_LABEL=$9.99

# Server-only Stripe configuration. Never expose these as NEXT_PUBLIC_* values.
STRIPE_SECRET_KEY=
STRIPE_FRIENDSHIP_PRICE_ID=

# Reserved for the later persistent WorldCore phase. The current free analyzer
# and lightweight checkout entitlement flow do not require a database.
DATABASE_URL=
